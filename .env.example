# Allegro Evaluate configuration.
# Copy this file to `.env` and fill in your values.

# OpenRouter API key (required for LLM evaluation).
OPENROUTER_API_KEY=

# Primary (strongest) model used for deep evaluation.
PRIMARY_MODEL=nvidia/nemotron-3-ultra

# Fallback models, tried in order when the primary is unavailable.
# Free OpenRouter variants are suffixed with `:free`.
FALLBACK_MODELS=["meta-llama/llama-3.1-70b-instruct:free","qwen/qwen-2.5-72b-instruct:free","mistralai/mixtral-8x7b-instruct:free","google/gemma-2-27b-it:free"]

# Cheap model used for stage-1 quick filtering (defaults to first fallback).
# STAGE1_MODEL=meta-llama/llama-3.1-70b-instruct:free

# Pipeline tuning
MAX_LISTINGS=50
TOP_K=3
STAGE1_CANDIDATES=15
STAGE1_BATCH_SIZE=10
STAGE2_CONCURRENCY=4

# HTTP / retries
REQUEST_TIMEOUT=60.0
MAX_RETRIES=3
RETRY_BACKOFF=1.5

# Scraping (be respectful)
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0
PAGE_LOAD_TIMEOUT=30000
HEADLESS=true
MAX_PAGES=10

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
